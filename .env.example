# Copiá este archivo como .env.local y completá los valores.

# Base local (docker compose up -d db)
DATABASE_URL=postgresql://app_riders:app_riders@localhost:5432/app_riders

# Clave para firmar la sesión. Generala con: openssl rand -base64 32
AUTH_SECRET=

# Ciudad que se agrega a las direcciones al buscarlas en el mapa
# (si escribís "3 de Febrero 1067", se busca "3 de Febrero 1067, Buenos Aires, Argentina")
GEOCODE_CIUDAD=Buenos Aires
